<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>

    <!-- Leaflet CSS -->
    <link
      rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
      crossorigin=""
    />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <!-- Header -->
    <header>
      <h1>🚀 Real-Time Device Tracker</h1>
      <div class="status-bar">
        <span id="connection-status" class="status-indicator"
          >Connecting...</span
        >
        <span id="user-count" class="user-count">Users: 0</span>
      </div>
    </header>

    <!-- Main content -->
    <main>
      <!-- Control Panel -->
      <div class="control-panel">
        <button id="start-tracking" class="btn btn-primary">
          Start Tracking
        </button>
        <button id="stop-tracking" class="btn btn-secondary">
          Stop Tracking
        </button>
        <button id="center-map" class="btn btn-info">Center Map</button>
        <div class="location-info">
          <span id="current-location">Location: Not available</span>
        </div>
      </div>

      <!-- Map Container -->
      <div id="map-container">
        <div id="map"></div>
      </div>

      <!-- Connected Users Panel -->
      <div class="users-panel">
        <h3>Connected Devices</h3>
        <ul id="users-list"></ul>
      </div>
    </main>

    <!-- Leaflet JavaScript -->
    <script
      src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
      integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
      crossorigin=""
    ></script>

    <!-- Socket.io JavaScript -->
    <script src="/socket.io/socket.io.js"></script>

    <!-- Custom JavaScript -->
    <script src="/js/script.js"></script>
  </body>
</html>
